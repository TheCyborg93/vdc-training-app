generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  TRAINER
}

enum TrainingPlanStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TrainingDayStatus {
  PLANNED
  PUBLISHED
  RUNNING
  COMPLETED
  CANCELLED
}

enum BoardSessionStatus {
  NOT_STARTED
  RUNNING
  PAUSED
  COMPLETED
}

enum HomeSessionStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum ExerciseResultType {
  HITS_0_TO_3
  SCORE_0_TO_180
  CHECKOUT
  LEGS
  TIME_BASED
  BOOLEAN
  CUSTOM
}

enum ExerciseEngine {
  AUTO
  BOB27
  AROUND_CLOCK
  AROUND_DOUBLES
  AROUND_TREBLES
  X01
  CHECKOUT_LADDER
  SCORING
  SHANGHAI
  JDC_CHALLENGE
  DOUBLES_ROUNDS
  BULL_ROUNDS
  HIT_ROUNDS
  TIME_BASED
  CUSTOM
}

enum ExerciseCompletionMode {
  ENGINE_DEFAULT
  TARGET_REACHED
  VISIT_LIMIT
  DART_LIMIT
  TIME_LIMIT
  MANUAL
}

enum ResultAuditAction {
  CREATED
  UPDATED
  UNDONE
  DELETED
}

enum DomainEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  RETRY
  DEAD_LETTER
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TRAINER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plans TrainingPlan[]
}

model Player {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  displayName String
  active      Boolean  @default(true)
  skillLevel  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainingDayPlayers TrainingDayPlayer[]
  boardAssignments  BoardAssignment[]
  results           ExerciseResult[]
  homePlans         HomeTrainingPlan[]
  homeSessions      HomeTrainingSession[]
  homeResults       HomeExerciseResult[]
}

model Board {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  location  String?
  active    Boolean  @default(true)
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainingDayBoards TrainingDayBoard[]
  assignments       BoardAssignment[]
  sessions          BoardSession[]
}

model ExerciseCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  exercises ExerciseCategoryLink[]
}

model Exercise {
  id               Int                       @id @default(autoincrement())
  name             String
  shortDescription String?
  description      String                    @db.Text
  instructions     String?                   @db.Text
  materials        String?
  trainerNotes     String?                   @db.Text
  defaultMinutes   Int
  minPlayers       Int                       @default(1)
  maxPlayers       Int?
  difficulty       Int                       @default(1)
  intensity        Int                       @default(5)
  funFactor        Int                       @default(5)
  learningCurve    Int                       @default(5)
  resultType       ExerciseResultType
  engine           ExerciseEngine            @default(AUTO)
  completionMode   ExerciseCompletionMode    @default(ENGINE_DEFAULT)
  completionValue  Int?
  resultConfigJson Json?
  tagsJson         Json?
  variantsJson     Json?
  favorite         Boolean                   @default(false)
  usageCount       Int                       @default(0)
  active           Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  categories  ExerciseCategoryLink[]
  planItems   TrainingPlanExercise[]
  results     ExerciseResult[]
  homeResults HomeExerciseResult[]
}

model ExerciseCategoryLink {
  exerciseId Int
  categoryId Int

  exercise Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  category ExerciseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([exerciseId, categoryId])
}

model TrainingPlan {
  id          Int                @id @default(autoincrement())
  title       String
  goal        String
  durationMin Int
  status      TrainingPlanStatus @default(DRAFT)
  createdById Int
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  createdBy    User                   @relation(fields: [createdById], references: [id])
  exercises    TrainingPlanExercise[]
  trainingDays TrainingDay[]
}

model TrainingPlanExercise {
  id             Int @id @default(autoincrement())
  trainingPlanId Int
  exerciseId     Int
  position       Int
  durationMin    Int
  settingsJson   Json?

  trainingPlan TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  exercise     Exercise     @relation(fields: [exerciseId], references: [id])

  @@unique([trainingPlanId, position])
}

model TrainingDay {
  id             Int               @id @default(autoincrement())
  trainingPlanId Int
  trainingDate   DateTime
  status         TrainingDayStatus @default(PLANNED)
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  trainingPlan TrainingPlan       @relation(fields: [trainingPlanId], references: [id])
  players      TrainingDayPlayer[]
  boards       TrainingDayBoard[]
  assignments  BoardAssignment[]
  sessions     BoardSession[]
}

model TrainingDayPlayer {
  trainingDayId Int
  playerId      Int

  trainingDay TrainingDay @relation(fields: [trainingDayId], references: [id], onDelete: Cascade)
  player      Player      @relation(fields: [playerId], references: [id])

  @@id([trainingDayId, playerId])
}

model TrainingDayBoard {
  trainingDayId Int
  boardId       Int

  trainingDay TrainingDay @relation(fields: [trainingDayId], references: [id], onDelete: Cascade)
  board       Board       @relation(fields: [boardId], references: [id])

  @@id([trainingDayId, boardId])
}

model BoardAssignment {
  id            Int @id @default(autoincrement())
  trainingDayId Int
  boardId       Int
  playerId      Int
  position      Int

  trainingDay TrainingDay @relation(fields: [trainingDayId], references: [id], onDelete: Cascade)
  board       Board       @relation(fields: [boardId], references: [id])
  player      Player      @relation(fields: [playerId], references: [id])

  @@unique([trainingDayId, playerId])
  @@unique([trainingDayId, boardId, position])
}

model BoardSession {
  id                Int                @id @default(autoincrement())
  trainingDayId     Int
  boardId           Int
  status            BoardSessionStatus @default(NOT_STARTED)
  currentExerciseId Int?
  startedAt         DateTime?
  completedAt       DateTime?
  randomOrderJson   Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  trainingDay TrainingDay      @relation(fields: [trainingDayId], references: [id], onDelete: Cascade)
  board       Board            @relation(fields: [boardId], references: [id])
  results     ExerciseResult[]

  @@unique([trainingDayId, boardId])
}

model ExerciseResult {
  id              Int      @id @default(autoincrement())
  boardSessionId  Int
  exerciseId      Int
  playerId        Int
  roundNumber     Int
  valueJson       Json
  calculatedScore Float?
  correctedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  boardSession BoardSession @relation(fields: [boardSessionId], references: [id], onDelete: Cascade)
  exercise     Exercise     @relation(fields: [exerciseId], references: [id])
  player       Player       @relation(fields: [playerId], references: [id])
  audits       ResultAudit[]
}

model HomeTrainingPlan {
  id          Int      @id @default(autoincrement())
  playerId    Int
  title       String
  goal        String
  durationMin Int
  planJson    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  player   Player                @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sessions HomeTrainingSession[]
}

model HomeTrainingSession {
  id                 Int               @id @default(autoincrement())
  homeTrainingPlanId Int
  playerId           Int
  status             HomeSessionStatus @default(RUNNING)
  exerciseIndex      Int               @default(0)
  stateJson          Json
  startedAt          DateTime          @default(now())
  pausedAt           DateTime?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt

  plan    HomeTrainingPlan  @relation(fields: [homeTrainingPlanId], references: [id], onDelete: Cascade)
  player  Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  results HomeExerciseResult[]

  @@index([playerId, status])
}

model HomeExerciseResult {
  id                    Int      @id @default(autoincrement())
  homeTrainingSessionId Int
  exerciseId            Int
  playerId              Int
  exerciseIndex         Int
  roundNumber           Int
  valueJson             Json
  calculatedScore       Float?
  correctedAt           DateTime?
  deletedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  session  HomeTrainingSession @relation(fields: [homeTrainingSessionId], references: [id], onDelete: Cascade)
  exercise Exercise            @relation(fields: [exerciseId], references: [id])
  player   Player              @relation(fields: [playerId], references: [id])
  audits   ResultAudit[]

  @@index([homeTrainingSessionId, exerciseIndex])
}

model ResultAudit {
  id                   Int               @id @default(autoincrement())
  exerciseResultId     Int?
  homeExerciseResultId Int?
  action               ResultAuditAction
  beforeJson           Json?
  afterJson            Json?
  reason               String?
  createdAt            DateTime          @default(now())

  exerciseResult     ExerciseResult?     @relation(fields: [exerciseResultId], references: [id], onDelete: Cascade)
  homeExerciseResult HomeExerciseResult? @relation(fields: [homeExerciseResultId], references: [id], onDelete: Cascade)

  @@index([exerciseResultId])
  @@index([homeExerciseResultId])
}

model DomainEventRecord {
  id            String            @id
  name          String
  payloadJson   Json
  metadataJson  Json
  occurredAt    DateTime
  status        DomainEventStatus @default(PENDING)
  attempts      Int               @default(0)
  nextAttemptAt DateTime?
  processedAt   DateTime?
  lastError     String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, nextAttemptAt])
  @@index([name, occurredAt])
}
